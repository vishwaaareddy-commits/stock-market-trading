# Copy to .env.local. Only NEXT_PUBLIC_* values are exposed to the browser; never put secrets here.
# Backend origin or full API URL; "/api/v1" is appended automatically if missing.
#   local:  http://127.0.0.1:8000
#   Vercel: https://<your-render-service>.onrender.com   (set in Vercel project env, then REDEPLOY:
#           NEXT_PUBLIC_* values are inlined at build time)
NEXT_PUBLIC_API_URL=http://127.0.0.1:8000

# Server-side only (used by the /api/v1 proxy rewrite in next.config.ts). Optional: defaults to the
# origin of NEXT_PUBLIC_API_URL. Set this on Vercel to your Render backend origin.
#   BACKEND_ORIGIN=https://<your-render-service>.onrender.com
