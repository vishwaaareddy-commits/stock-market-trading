{
  "name": "backend",
  "version": "0.1.0",
  "private": true,
  "description": "Stock Market Trading System - FastAPI backend (npm scripts wrap the .venv Python interpreter)",
  "scripts": {
    "dev": "node scripts/py.js -m uvicorn app.main:app --reload --host 127.0.0.1 --port 8000",
    "start": "node scripts/py.js -m uvicorn app.main:app --host 127.0.0.1 --port 8000",
    "test": "node scripts/py.js -m pytest",
    "migrate": "node scripts/py.js -m alembic upgrade head",
    "migrate:status": "node scripts/py.js -m alembic current --verbose",
    "migrate:history": "node scripts/py.js -m alembic history --verbose",
    "migrate:new": "node scripts/py.js -m alembic revision --autogenerate -m",
    "migrate:down": "node scripts/py.js -m alembic downgrade -1",
    "migrate:sql": "node scripts/py.js -m alembic upgrade head --sql",
    "generate:key": "node scripts/py.js scripts/generate_key.py",
    "install:deps": "node scripts/py.js -m pip install -r requirements.txt"
  }
}
