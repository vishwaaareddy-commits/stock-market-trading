# Copy to .env and edit. Never commit .env.
APP_NAME="Stock Market Trading System"
APP_ENV=development
LOG_LEVEL=INFO

# Frontend origins allowed to call the API (JSON list)
CORS_ORIGINS=["http://localhost:3000","http://127.0.0.1:3000"]

# PostgreSQL (SQLAlchemy URL, psycopg v3 driver). Use a LOCAL/DEV database.
# Example: postgresql+psycopg://USER:PASSWORD@localhost:5432/trading_dev
DATABASE_URL=

# Where the browser lands after the Upstox OAuth callback (frontend base URL)
FRONTEND_URL=http://localhost:3000

# Upstox read-only market data. Set these ONLY on the backend (never in the frontend).
UPSTOX_CLIENT_ID=
UPSTOX_CLIENT_SECRET=
# Must exactly match the redirect URL registered in the Upstox developer app:
UPSTOX_REDIRECT_URI=https://stock-market-trading-api-5flm.onrender.com/api/v1/auth/upstox/callback
# Fernet key for encrypting the stored token. Generate with:
#   npm run generate:key
UPSTOX_TOKEN_ENCRYPTION_KEY=
# REQUIRED IN PRODUCTION whenever any Upstox variable is set: only this Upstox user id may connect.
# The app refuses to start (APP_ENV=production) if Upstox is enabled without it. Find your id with
# a first dev-mode login, or in the Upstox profile. Optional in development.
UPSTOX_ALLOWED_USER_ID=

# Paper trading only. Live trading is not implemented and cannot be enabled.
TRADING_MODE=paper

# --- Authentication & sessions -----------------------------------------------------------
SESSION_ABSOLUTE_HOURS=12          # hard session expiry
SESSION_IDLE_MINUTES=120           # expire after this long without activity/heartbeat
HEARTBEAT_TIMEOUT_SECONDS=90       # a user is "online" only if a heartbeat is this recent
MIN_PASSWORD_LENGTH=12
LOGIN_MAX_FAILURES=5               # per account, within LOGIN_WINDOW_MINUTES
LOGIN_IP_MAX_FAILURES=30           # per client IP
LOGIN_WINDOW_MINUTES=15

# --- Client IP behind proxies (login throttling + audit) ----------------------------------
# X-Forwarded-For is NEVER trusted by default. Each trusted proxy appends the address it saw, so with
# N trusted proxies in front of the app the client is the N-th entry from the RIGHT; anything to
# the left is client-controlled and ignored. 0 = ignore forwarding headers entirely (fail closed).
# While 0 behind a platform proxy, per-IP throttling is simply inactive (per-account throttling still
# applies) and the app never lumps all users into the proxy's IP.
# Find the right N: sign in as Super Admin through the real frontend, call
#   GET /api/v1/admin/diagnostics/client-ip   and count from the right to your own public IP.
TRUSTED_PROXY_HOPS=0
# Optional hardening: only honour the header when the direct TCP peer is in these networks (JSON list)
# TRUSTED_PROXY_CIDRS=["10.0.0.0/8"]
# Optional hardening: only honour the header when the proxy sends this value in X-Proxy-Secret
# TRUSTED_PROXY_SECRET=

# --- One-time Super Admin bootstrap ------------------------------------------------------
# Run once:  npm run bootstrap:superadmin   (refuses if a Super Admin already exists)
# Then REMOVE the password from the environment. Never commit real values.
BOOTSTRAP_SUPERADMIN_USERNAME=
BOOTSTRAP_SUPERADMIN_EMAIL=
BOOTSTRAP_SUPERADMIN_PASSWORD=

# --- Virtual wallet ------------------------------------------------------------------------
# Simulated charges as a fraction of turnover (0.0003 = 0.03%). Paper trading only.
PAPER_CHARGE_RATE=0.0003
