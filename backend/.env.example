# Copy to .env and edit. Never commit .env.
APP_NAME="Stock Market Trading System"
APP_ENV=development
LOG_LEVEL=INFO

# Frontend origins allowed to call the API (JSON list)
CORS_ORIGINS=["http://localhost:3000","http://127.0.0.1:3000"]

# PostgreSQL (SQLAlchemy URL, psycopg v3 driver). Use a LOCAL/DEV database.
# Example: postgresql+psycopg://USER:PASSWORD@localhost:5432/trading_dev
DATABASE_URL=

# Paper trading only. Live trading is not implemented and cannot be enabled.
TRADING_MODE=paper
