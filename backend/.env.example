# Copy to .env and edit. Never commit .env.
APP_NAME="Stock Market Trading System"
APP_ENV=development
LOG_LEVEL=INFO

# Frontend origins allowed to call the API (JSON list)
CORS_ORIGINS=["http://localhost:3000","http://127.0.0.1:3000"]

# PostgreSQL (SQLAlchemy URL, psycopg v3 driver). Use a LOCAL/DEV database.
# Example: postgresql+psycopg://USER:PASSWORD@localhost:5432/trading_dev
DATABASE_URL=

# Where the browser lands after the Upstox OAuth callback (frontend base URL)
FRONTEND_URL=http://localhost:3000

# Upstox read-only market data. Set these ONLY on the backend (never in the frontend).
UPSTOX_CLIENT_ID=
UPSTOX_CLIENT_SECRET=
# Must exactly match the redirect URL registered in the Upstox developer app:
UPSTOX_REDIRECT_URI=https://stock-market-trading-api-5flm.onrender.com/api/v1/auth/upstox/callback
# Fernet key for encrypting the stored token. Generate with:
#   npm run generate:key
UPSTOX_TOKEN_ENCRYPTION_KEY=
# Optional but recommended: only accept OAuth logins from this Upstox user id
UPSTOX_ALLOWED_USER_ID=

# Paper trading only. Live trading is not implemented and cannot be enabled.
TRADING_MODE=paper
